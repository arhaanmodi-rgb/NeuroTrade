# ============================================================
# NEUROTRADE PLATFORM CONFIGURATION (TEMPLATE)
# ============================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file with real credentials to GitHub.

# 1. Market Data API (BharatStock / Exchange Feeds)
BHARAT_STOCK_API_KEY=your_bharat_stock_api_key_here
BHARATSTOCK_API_KEY=your_bharat_stock_api_key_here

# 2. Cloud Database (PostgreSQL on Neon / Supabase / Render / AWS RDS)
DATABASE_URL=postgresql://username:password@your-cloud-host.neon.tech/neondb?sslmode=require

# 3. JWT Authentication Security
SECRET_KEY=generate_a_secure_32_character_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
